# Normalize text to LF in the repository; native Windows entry points keep CRLF
# so they behave predictably in cmd.exe and PowerShell.
* text=auto eol=lf

*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Generated upstream notices retain the original license text and whitespace.
/THIRD_PARTY_NOTICES.txt linguist-generated=true -whitespace

# Binary fixtures and assets must never be converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.pdf binary
