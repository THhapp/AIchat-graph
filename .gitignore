# AIchat-graph .gitignore
# Local-only. keeps source, docs, tests and fixtures tracked.

# Dependencies and build output (generated, re-creatable)
node_modules/
dist/
coverage/
*.tsbuildinfo

# Workspace runtime data (never source content)
.aichat/
**/.aichat/

# Env, secrets and keys
.env
.env.*
*.env
.envrc
!.env.example
# 已安装 Skill 的本机安装绑定（CLI／工作区绝对路径），不入库
**/local.env.json
*.pem
*.key
*.pfx
*.p12
*.jks
id_rsa*
id_ed25519*
secrets/
credentials/

# Logs and crash dumps
*.log
logs/
npm-debug.log*
yarn-error.log*
*.stackdump

# Machine-local launcher configuration (kept out of the repo on purpose)
/launcher.local.json
*.local.json
/.local/

# Local workspaces that must not be committed by accident.
# The daily workspace is bound by machine-local configuration; development defaults
# to the ignored .local/ directory. Rules below are root-anchored so nested fixture
# workspaces stay tracked; workspace.json / topics/ are never ignored by name.
/workspace/
/workspaces/
/.data/
local-workspace/
workspaces.local/
.aichat-local/

# Windows shell links and OS junk
*.lnk
*.url
Thumbs.db
Desktop.ini
.DS_Store

# Editor / tool scratch space
.vscode/
.idea/
*.swp
*.tmp
.tmp-*/
*.bak

# Private design notes and legacy local paths; never publish user material.
/docs/design-notes.md
/DEVELOPMENT_PROMPT.md
/thinking-map-design.md
/docs/reference/

# Notes: tests/fixtures/** (Markdown, JSON, images) is intentionally NOT ignored.
# skills/** and src/** are source and must stay tracked.