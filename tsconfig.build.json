{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": [
    "src/build-info.ts",
    "src/next/**/*.ts",
    "src/portable/**/*.ts",
    "src/core/**/*.ts",
    "src/storage/**/*.ts",
    "src/index/**/*.ts",
    "src/service/**/*.ts",
    "src/cli/**/*.ts",
    "src/shared/**/*.ts",
    "src/export/**/*.ts"
  ],
  "exclude": ["tests", "src/web", "dist", "node_modules"]
}
